# Copy this file to .env and adjust as needed.
# Every value below has a sensible default in app.py — you only need to
# set the ones you want to change.

# Longest edge (in px) that any output image will be resized to. Smaller
# images are left alone (never upscaled).
MAX_DIMENSION=1600

# WebP/JPEG-style quality, 1-100.
QUALITY=82

# Output container format, passed straight to ImageMagick.
OUTPUT_FORMAT=webp

# Reject requests with more files than this.
MAX_FILES_PER_REQUEST=50

# Reject requests whose total upload size (in MB) exceeds this.
MAX_CONTENT_LENGTH_MB=200

# Kill a single file's conversion if ImageMagick takes longer than this
# (seconds) — guards against corrupt/hostile files that hang.
CONVERT_TIMEOUT_SECONDS=30

# Standard Flask/Python knobs.
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
FLASK_DEBUG=false
